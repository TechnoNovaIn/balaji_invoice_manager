# Balaji InvoiceHub Environment Variables Template (.env.example)

DJANGO_SECRET_KEY=change-me-to-a-secure-random-key-in-production
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=invoices.balajitransports.com,127.0.0.1,localhost

# Database Configuration (PostgreSQL 18)
DB_NAME=balaji_invoicehub_db
DB_USER=postgres
DB_PASSWORD=your_secure_postgres_password
DB_HOST=127.0.0.1
DB_PORT=5432

# Timezone & Localization
TIME_ZONE=Asia/Kolkata
USE_TZ=True

# WhatsApp Cloud API (Keep True in dev/staging; False only in production with verified Meta app)
WHATSAPP_SANDBOX_MODE=True
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=

# Backup Configuration
BACKUP_DIR=e:\Balaji_IA_VM\backups
BACKUP_RETENTION_DAYS=30

# File Upload Limits
MAX_FILE_SIZE_BYTES=15728640
MAX_SUBMISSION_SIZE_BYTES=41943040

