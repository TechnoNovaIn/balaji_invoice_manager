# Balaji InvoiceHub Environment Variables Template (.env.example)

# Core Security & Host Configuration
# Generate a strong secret key (>= 50 chars, no 'django-insecure-' prefix):
# python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=replace-with-50-plus-char-cryptographic-random-secret-key
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=invoicehub.balajitransports.com,127.0.0.1,localhost
DJANGO_CSRF_TRUSTED_ORIGINS=https://invoicehub.balajitransports.com,http://127.0.0.1:8000,http://localhost:8000

# Production HTTPS / Cookie / HSTS Security
DJANGO_ENABLE_SSL=True
SECURE_HSTS_SECONDS=31536000

# Database Configuration (PostgreSQL 18)
DB_NAME=balaji_invoicehub_db
DB_USER=postgres
DB_PASSWORD=your_secure_postgres_password
DB_HOST=127.0.0.1
DB_PORT=5432

# Timezone & Localization
TIME_ZONE=Asia/Kolkata
USE_TZ=True

# WhatsApp Cloud API (Keep True in dev/staging; False only in production with verified Meta app)
WHATSAPP_SANDBOX_MODE=True
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=

# Backup & PostgreSQL CLI Configuration
# Leave PG_BIN_DIR empty on Linux/PATH-configured hosts, or point to your PostgreSQL bin directory
BACKUP_STORAGE_PATH=/var/backups/balaji_invoicehub
BACKUP_RETENTION_DAYS=3650
PG_BIN_DIR=

# File Upload Limits (Bytes: 100MB default)
MAX_FILE_SIZE_BYTES=104857600
MAX_SUBMISSION_SIZE_BYTES=104857600

# Gemini Vision AI Configuration
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Security & Session Configuration
DJANGO_TRUSTED_PROXY_COUNT=1
DJANGO_TRUSTED_PROXY_IPS=127.0.0.1,::1
DJANGO_TRUST_CF_CONNECTING_IP=True
LOGIN_MAX_ATTEMPTS=5
LOGIN_ATTEMPT_WINDOW_SECONDS=300
LOGIN_COOLDOWN_SECONDS=300
PRIVILEGED_SESSION_AGE=28800
EXTERNAL_SUBMITTER_SESSION_AGE=1209600
EMPLOYEE_SESSION_AGE=31536000

# Waitress Production Server & Logging
WAITRESS_HOST=127.0.0.1
WAITRESS_PORT=8000
WAITRESS_THREADS=8
WAITRESS_CHANNEL_TIMEOUT=180
WAITRESS_TRUSTED_PROXY=127.0.0.1
DJANGO_LOG_LEVEL=INFO
